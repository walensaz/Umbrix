# Set default behavior to automatically normalize line endings
* text=auto

# Explicit text files with LF
*.scala text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.gradle text eol=lf
*.sh text eol=lf
gradlew text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
